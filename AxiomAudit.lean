    match env.checked.get.find? name with
    | none => throwError "Missing source declaration: {name}"
    | some info =>
      if info.isUnsafe then throwError "Unsafe source declaration: {name}"
  let project := env.constants.toList.filter fun p =>
    (`ScalarMonotone).isPrefixOf (privateToUserName p.1)
  let names := project.filter (fun p => !p.2.isUnsafe) |>.map Prod.fst
  if names.isEmpty then throwError "No project declarations were found."
  let action : CollectAxioms.M Unit := names.forM CollectAxioms.collect
  let (_, state) := (action.run env).run {}
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  for ax in state.axioms do
    unless allowed.contains ax do
      throwError "Unexpected axiom: {ax}"
  logInfo m!"Public source declarations checked: {requested.size}"
  logInfo m!"Audited safe kernel declarations: {names.length}"
  logInfo m!"Compiler-only unsafe auxiliaries excluded: {project.length - names.length}"
  logInfo m!"Transitive axiom dependencies: {state.axioms.qsort Name.lt |>.toList}"
  logInfo "PASS: all safe kernel declarations, including private helpers and generated instances, use only the permitted standard axioms."
