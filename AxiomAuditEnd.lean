  let project := env.constants.toList.filter fun p =>
    (`ScalarMonotone.EndOfPaper).isPrefixOf (privateToUserName p.1)
  let names := project.filter (fun p => !p.2.isUnsafe) |>.map Prod.fst
  if names.isEmpty then throwError "No end-of-paper declarations were found."
  let action : CollectAxioms.M Unit := names.forM CollectAxioms.collect
